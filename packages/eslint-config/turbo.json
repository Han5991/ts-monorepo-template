{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // 가드 테스트는 패키지 밖의 앱·패키지 lint 설정을 읽는다. 입력으로 선언하지 않으면
    // 그 설정만 바뀌었을 때(규칙을 지우거나 풀었을 때) 캐시가 맞아 통과해 버린다.
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/*/eslint.config.mts",
        "$TURBO_ROOT$/packages/*/eslint.config.mts",
        "$TURBO_ROOT$/apps/*/package.json",
        "$TURBO_ROOT$/packages/*/package.json"
      ]
    }
  }
}
