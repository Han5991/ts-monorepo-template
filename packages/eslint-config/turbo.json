{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // 이 패키지에는 자기 eslint.config.mts가 없어 루트 설정이 적용된다 — 그 파일이 바뀌면 캐시를 버린다
    "lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/eslint.config.mts"]
    },
    // 가드 테스트는 패키지 밖의 앱·패키지 lint 설정에 더해, 탐침을 넣는 파일이 든 tsconfig 프로젝트의 타입(다른 패키지의 소스·
    // tsconfig·그 패키지가 쓰는 라이브러리의 타입)까지 읽는다 — 입력이 저장소 전부라 캐시하지 않는다. 캐시하면 패키지 밖만
    // 바뀌었을 때(규칙을 풀었거나 타입이 바뀌었을 때) 지난 결과가 그대로 통과해 버린다.
    "test": {
      "cache": false
    }
  }
}
