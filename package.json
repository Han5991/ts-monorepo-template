{
  "name": "ts-monorepo-template",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,mts,tsx,js,jsx,json,md,mjs,cjs,yml,yaml}\" --ignore-path .prettierignore --cache",
    "format:check": "prettier --check \"**/*.{ts,mts,tsx,js,jsx,json,md,mjs,cjs,yml,yaml}\" --ignore-path .prettierignore --cache",
    "prepare": "lefthook install",
    "docs:index": "pnpm --filter @app/docs-index generate",
    "init:project": "node scripts/init.ts",
    "check-types:tooling": "tsc -p tsconfig.json",
    "lint:tooling": "eslint --no-error-on-unmatched-pattern eslint.config.mts scripts",
    "test:scripts": "bash -c 'shopt -s nullglob; for t in .github/scripts/*.test.sh; do bash \"$t\" || exit 1; done'"
  },
  "devDependencies": {
    "@app/eslint-config": "workspace:*",
    "@app/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:lint",
    "jiti": "catalog:lint",
    "lefthook": "^2.2.2",
    "prettier": "catalog:",
    "turbo": "^2.11.10",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.0"
  }
}
